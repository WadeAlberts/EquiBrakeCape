# =============================================================================
# .env
# =============================================================================
# Stores all secret credentials.
# NEVER push this file to GitHub - it is already in .gitignore
# =============================================================================

# --- PAYFAST CREDENTIALS ---
# These are the FREE sandbox (test) credentials provided by PayFast.
# No account needed to test! Real money is never moved in sandbox mode.
# When you go live (Phase 6), replace these with your real account credentials
# from: https://www.payfast.co.za → Login → Integration → Merchant Details

PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn

# --- SANDBOX MODE ---
# true  = test mode  (use sandbox.payfast.co.za, no real money)
# false = live mode  (use www.payfast.co.za, real money!) ← Phase 6 only
PAYFAST_SANDBOX=true

# --- BASE URL ---
# This is the address PayFast uses to send customers BACK to your site
# AND to send the secret ITN payment notification to your server.
#
# LOCAL TESTING:
#   Step 1 - Start ngrok in a terminal: ngrok http 5000
#   Step 2 - Copy the https URL ngrok gives you (e.g. https://abc123.ngrok-free.app)
#   Step 3 - Paste it below and restart Flask
#
# PRODUCTION (Phase 6):
#   Replace with your Railway or Render URL e.g. https://equibrakecape.up.railway.app
BASE_URL=http://localhost:5000

# --- FLASK ---
FLASK_SECRET_KEY=equibrakecape-dev-secret-key-2025